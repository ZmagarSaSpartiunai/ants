# Match history. Leave unset and the game runs fine — matches simply are not
# recorded, and solo play never needed a database at all.
# DATABASE_URL=postgres://ants:ПАРОЛЬ@127.0.0.1:5432/ants

# Shared password while the game is unfinished. Unset it and the gate is gone
# entirely, which is what happens when the game is ready to be public.
# ANTS_PASSWORD=

# Loopback only. The outside world reaches this through the Cloudflare tunnel.
HOST=127.0.0.1
PORT=8787
